{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Post",
    "description": "Blog articles for Hradiska.sk"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "maxLength": 500
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "coverPosition": {
      "type": "string",
      "default": "center center",
      "maxLength": 50,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "galleryColumns": {
      "type": "integer",
      "required": false,
      "default": 3,
      "min": 2,
      "max": 4,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::blog-category.blog-category",
      "inversedBy": "posts",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::blog-tag.blog-tag",
      "inversedBy": "posts",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "authorName": {
      "type": "string",
      "maxLength": 100,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "readingTime": {
      "type": "integer",
      "min": 1,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "originalPublishedDate": {
      "type": "datetime",
      "description": "Pôvodný publish dátum (napr. z Blogger migrácie). Strapi managed publishedAt sa nastavuje pri publish action; frontend zobrazuje originalPublishedDate || publishedAt.",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "comments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog-comment.blog-comment",
      "mappedBy": "post",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "metaTitle": {
      "type": "string",
      "maxLength": 70
    },
    "metaDescription": {
      "type": "text",
      "maxLength": 160
    },
    "quotes": {
      "type": "component",
      "repeatable": true,
      "component": "shared.quote"
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "content.rich-text",
        "content.image-block",
        "content.quote-block",
        "content.image-gallery",
        "content.embed",
        "content.sources",
        "content.poem"
      ]
    },
    "location": {
      "type": "component",
      "repeatable": false,
      "component": "sidebar.location",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "keyFacts": {
      "type": "component",
      "repeatable": true,
      "component": "sidebar.key-fact"
    },
    "timeline": {
      "type": "component",
      "repeatable": true,
      "component": "sidebar.timeline-event"
    }
  }
}
