: 1em; margin-right: 1em;\"><img border=\"0\" height=\"320\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiif6Drr2PmMuAL8UQpwpdhNcrX9p2dgRnvUzc_BPPAaWX4MaClxdVlMjFX8ubnbz7BM11Xb-Y8SC35HsdSX0ZCrCVIL72860UgqbI53j_WY_iM2MQEoGsvYJCbtymiFF5k8ySTT3hF4KI/s320/IMG_3841.JPG\" width=\"213\" /></a></div>\n<div style=\"text-align: justify;\">\n<br /></div>\n<div style=\"text-align: justify;\">\n<br /></div>\n<div style=\"text-align: justify;\">\nVeríme, že tabuľa prispeje k lepšej informovanosti turistov, ktorí na toto magické miesto zavítajú a že sa nestane obeťou vandalizmu. Ďakujem mestu Modra, najmä pani primátorke a &nbsp;zamestnancom mestského úradu za ústretovosť a pomoc na tomto projekte.&nbsp;</div>\n"},"link":[{"rel":"replies","type":"application/atom+xml","href":"http://www.hradiska.sk/feeds/8394275289263383082/comments/default","title":"Zverejniť komentáre"},{"rel":"replies","type":"text/html","href":"http://www.hradiska.sk/2013/10/informacna-tabula-modra-zamcisko.html#comment-form","title":"3 komentárov"},{"rel":"edit","type":"application/atom+xml","href":"http://www.blogger.com/feeds/6818054921907446479/posts/default/8394275289263383082"},{"rel":"self","type":"application/atom+xml","href":"http://www.blogger.com/feeds/6818054921907446479/posts/default/8394275289263383082"},{"rel":"alternate","type":"text/html","href":"http://www.hradiska.sk/2013/10/informacna-tabula-modra-zamcisko.html","title":"Informačná tabuľa Modra - Zámčisko"}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thumbnail":{"xmlns$media":"http://search.yahoo.com/mrss/","url":"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhmQabZKNjEZonfRrvUoDwOeXl1iz4NhTysgho4i8OU4Fkp3NPmxxs6uhQP0Q-LMnOPO6WcWkI2aGIaJtxqZoGpy_bU3XQPLpQdnien5K5tksAM56rBd8D4JFHR4YJoXmXTodHwL63YTv8/s72-c/fotka+1.JPG","height":"