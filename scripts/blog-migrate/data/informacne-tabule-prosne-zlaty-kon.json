sCmR3QJGxFVrMIcyXMnlgZFkVNElq-2r0N73Qn3zp2UjrXadbDUmfCS9301jk/s1600/IMG_7655.JPG\" width=\"213\" /></a></div>\n<br />\n<div class=\"separator\" style=\"clear: both; text-align: center;\">\n<a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjwb1Ohwd7g8mrslr_9gn50eyIZh75xldWRUIqek8sTH72QYLJsuB4IOUAlcNhHJyXaMGgZ8wUe7zjmCSipzLniiRmZc056Uon21hJnaY4RtRRs2k7XdzNoSAryqUrb7h5NOhvan51T5cM/s1600/IMG_7662.JPG\" imageanchor=\"1\" style=\"margin-left: 1em; margin-right: 1em;\"><img border=\"0\" height=\"213\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjwb1Ohwd7g8mrslr_9gn50eyIZh75xldWRUIqek8sTH72QYLJsuB4IOUAlcNhHJyXaMGgZ8wUe7zjmCSipzLniiRmZc056Uon21hJnaY4RtRRs2k7XdzNoSAryqUrb7h5NOhvan51T5cM/s1600/IMG_7662.JPG\" width=\"320\" /></a></div>\n<br />\n<table align=\"center\" cellpadding=\"0\" cellspacing=\"0\" class=\"tr-caption-container\" style=\"margin-left: auto; margin-right: auto; text-align: center;\"><tbody>\n<tr><td style=\"text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEh3e2hG_ah-QTCIU_DVS_g9rzFwXYJlG6bPAw7VepedRmmLbI-h532SWClRtdqen-LPOXlAsGuTiH1GydJh6oah5LZvCVOP0wG9hSyAxf2kwe76Go1oKwlkYCFdaXbd8e3XFiyDCQrZQeE/s1600/SAM_3972.JPG\" imageanchor=\"1\" style=\"margin-left: auto; margin-right: auto;\"><img border=\"0\" height=\"320\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEh3e2hG_ah-QTCIU_DVS_g9rzFwXYJlG6bPAw7VepedRmmLbI-h532SWClRtdqen-LPOXlAsGuTiH1GydJh6oah5LZvCVOP0wG9hSyAxf2kwe76Go1oKwlkYCFdaXbd8e3XFiyDCQrZQeE/s1600/SAM_3972.JPG\" width=\"240\" /></a></td></tr>\n<tr><td class=\"tr-caption\" style=\"text-align: center;\">Brendyx žehná našu tabuľu s medovinou</td></tr>\n</tbody></table>\n<br />\n<div class=\"separator\" style=\"clear: both; text-align: center;\">\n<a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhEq9ODHGJIBnl8Tb_qGXrs_4ssm4EjDkve9D67-As43cFEokFpUMD2Uyz2012gGw5uRcuBJFXOCNKaTF2AWnhmVW3V_0nTLEOkhu4Sy_qbNGcO36Ceh4WsS8gaLv8HW1eUt236fOxZsZA/s1600/SAM_3984.JPG\" imageanchor=\"1\" style=\"margin-left: 1em; margin-right: 1em;\"><img border=\"0\" height=\"320\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhEq9ODHGJIBnl8Tb_qGXrs_4ssm4EjDkve9D67-As43cFEokFpUMD2Uyz2012gGw5uRcuBJFXOCNKaTF2AWnhmVW3V_0nTLEOkhu4Sy_qbNGcO36Ceh4WsS8gaLv8HW1eUt236fOxZsZA/s1600/SAM_3984.JPG\" width=\"240\" /></a></div>\n<br />\n<div class=\"separator\" style=\"clear: both; text-align: center;\">\n</div>\n<br />\n<div class=\"separator\" style=\"clear: both; text-align: center;\">\n<a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhytoIIhZbvu8Dez3aPCCl73ZTTXQpVtNqgAakVij-KgR_dKpnqhRYm6pvEalsTUAHkcO9jWrarv6-FATF_PSe-YTxt3C-zqJs6mjxckRc09H8HyUZIaYNUgFSKeozReSxDvt4vnuwX7Ek/s1600/IMG_0957.JPG\" imageanchor=\"1\" style=\"margin-left: 1em; margin-right: 1em;\"><img border=\"0\" height=\"240\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhytoIIhZbvu8Dez3aPCCl73ZTTXQpVtNqgAakVij-KgR_dKpnqhRYm6pvEalsTUAHkcO9jWrarv6-FATF_PSe-YTxt3C-zqJs6mjxckRc09H8HyUZIaYNUgFSKeozReSxDvt4vnuwX7Ek/s1600/IMG_0957.JPG\" width=\"320\" /></a></div>\n<br />\n<div class=\"separator\" style=\"clear: both; text-align: center;\">\n<a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjCwzx-0COsxcoLpZszXRikHKmo4BFJ5szTZcn4p33gMG4eeA7YG_-UVNWl5yp6eC60lz0pGa4yRxfztWW_W6_-3irTQybeOzko-FOuGGc4sufNrL8Rs-1n9fkWCoznOjstejxhg-eGkxU/s1600/IMG_0958.JPG\" imageanchor=\"1\" style=\"margin-left: 1em; margin-right: 1em;\"><img border=\"0\" height=\"240\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjCwzx-0COsxcoLpZszXRikHKmo4BFJ5szTZcn4p33gMG4eeA7YG_-UVNWl5yp6eC60lz0pGa4yRxfztWW_W6_-3irTQybeOzko-FOuGGc4sufNrL8Rs-1n9fkWCoznOjstejxhg-eGkxU/s1600/IMG_0958.JPG\" width=\"320\" /></a></div>\n<br />\n<div class=\"separator\" style=\"clear: both; text-align: center;\">\n<a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhHB7mbBz8OI_aQGQhIAgref7ulbRYWJloyoCHC0Zn91Iu6qt6AFMjYjASIoWb4JYVt4yzBvdWQKwJlGVCziWgaGUwQ6N9lc8TJ6kz5isyUYrH7-RRaeTKWMUeQiBu4L4_xM9_0dCG3e7I/s1600/IMG_0959.JPG\" imageanchor=\"1\" style=\"margin-left: 1em; margin-right: 1em;\"><img border=\"0\" height=\"320\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhHB7mbBz8OI_aQGQhIAgref7ulbRYWJloyoCHC0Zn91Iu6qt6AFMjYjASIoWb4JYVt4yzBvdWQKwJlGVCziWgaGUwQ6N9lc8TJ6kz5isyUYrH7-RRaeTKWMUeQiBu4L4_xM9_0dCG3e7I/s1600/IMG_0959.JPG\" width=\"240\" /></a></div>\n<div style=\"text-align: justify;\">\n<br /></div>\n<div style=\"text-align: justify;\">\n<br /></div>\n<div style=\"text-align: justify;\">\nNa obetisku púchovskej kultúry v Uhliskách nás už čakali nielen kelti zo združenia Vae Victis, ktorí na miesto prišli v plnej keltskej výstroji, so štítmi a zbraňami, ale aj pán Ladislav Janech, ktorý na obetisku spravil hodnotnú výstavku zaujímavých nálezov púchovskej kultúry, ktoré má vo svojom múzeu. Návštevníci tak mohli nielen na vlastné oči vidieť, ale aj dotknúť sa vzácnych nálezov spred viac ako 2000 rokov, ktoré na našom území zanechal ľud púchovskej kultúry. &nbsp;Na obetisko prišiel aj jeho objaviteľ - pán Peter Kondrčík, ktorý nám porozprával, ako sa mu podarilo obetisko objaviť a spomenul si aj na list, ktorý mu poslal Anton Petrovský Šichman, kde písal, že toto miesto bude mať v budúcnosti mimoriadny archeologický význam. Pán Jozef Moravčík nám dal opäť kvalitný výklad o priebehu výskumu a o nálezoch, ktoré boli na obetisku nájdené. Naviac nám keltský druid Brendyx porozprával ničo o tom, akým spôsobom sa v minulosti vykonávali u keltov ľudské obety a potom v mene keltského boha slnka Taranisa nám tabuľu posvätil. &nbsp;</div>\n<div style=\"text-align: justify;\">\n<br /></div>\n<div class=\"separator\" style=\"clear: both; text-align: center;\">\n<a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgO7eS1fapIHOa4b2wGrucOfcOuvhZin3iH_0ThaFcGbS-wRhYAgh9Myrpb77beppjMRK4tocVTdIp3EDNV8V0rSGtCiOgEoRwNiaTr5BiA2iUxfzuGONt6FLpc_K3S5_QnYRBbe2RREWo/s1600/IMG_0940.JPG\" imageanchor=\"1\" style=\"margin-left: 1em; margin-right: 1em;\"><img border=\"0\" height=\"240\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgO7eS1fapIHOa4b2wGrucOfcOuvhZin3iH_0ThaFcGbS-wRhYAgh9Myrpb77beppjMRK4tocVTdIp3EDNV8V0rSGtCiOgEoRwNiaTr5BiA2iUxfzuGONt6FLpc_K3S5_QnYRBbe2RREWo/s1600/IMG_0940.JPG\" width=\"320\" /></a></div>\n<div style=\"text-align: justify;\">\n<br /></div>\n<div style=\"text-align: justify;\">\n<br /></div>\n<div style=\"text-align: justify;\">\nCelý deň prebiehal vo veľmi príjemnej priateľskej atmosfére a bez väčších stresov. Ďakujeme všetkým, ktorí sa na tejto skvelej akcii podieľali organizačne a ďakujeme aj za dobrú účasť ľudí z okolia, ktorí nás tiež prišli svojou účasťou podporiť.&nbsp;</div>\n<div style=\"text-align: justify;\">\n<br /></div>\n<div class=\"separator\" style=\"clear: both; text-align: center;\">\n<a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiElRZlYGolyHHvUbTP568NSFc8ve-CuhBvbu78_9ZLiN-HzmxQZ6NCA91xw_FgXKyR-KZXsZ0fXgRDYrjXaocvos2GshyphenhyphenLFS0q11QTPJYTrEn_ggIuSDH6rl0cORvn-z0vmTYQ2sSnfLc/s1600/IMG_7687.JPG\" imageanchor=\"1\" style=\"margin-left: 1em; margin-right: 1em;\"><img border=\"0\" height=\"213\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiElRZlYGolyHHvUbTP568NSFc8ve-CuhBvbu78_9ZLiN-HzmxQZ6NCA91xw_FgXKyR-KZXsZ0fXgRDYrjXaocvos2GshyphenhyphenLFS0q11QTPJYTrEn_ggIuSDH6rl0cORvn-z0vmTYQ2sSnfLc/s1600/IMG_7687.JPG\" width=\"320\" /></a></div>\n<br />\n<table align=\"center\" cellpadding=\"0\" cellspacing=\"0\" class=\"tr-caption-container\" style=\"margin-left: auto; margin-right: auto; text-align: center;\"><tbody>\n<tr><td style=\"text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEitvkCnUu3p2QxurVHMsFseJYdXV_IsCY6oRiXLOwJq5kFgG_4Qtvgq_4ORCdUpRVr5mSa06E2R06Jg17L9F_a5syCj1RBjavoyQIAht7llqOFavs17a4tZ50WK0JE2A4XPYTAgKGHQeA8/s1600/IMG_7680.JPG\" imageanchor=\"1\" style=\"margin-left: auto; margin-right: auto;\"><img border=\"0\" height=\"213\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEitvkCnUu3p2QxurVHMsFseJYdXV_IsCY6oRiXLOwJq5kFgG_4Qtvgq_4ORCdUpRVr5mSa06E2R06Jg17L9F_a5syCj1RBjavoyQIAht7llqOFavs17a4tZ50WK0JE2A4XPYTAgKGHQeA8/s1600/IMG_7680.JPG\" width=\"320\" /></a></td></tr>\n<tr><td class=\"tr-caption\" style=\"text-align: center;\">Pohľad na obetisko</td></tr>\n</tbody></table>\n<div style=\"text-align: justify;\">\n<table align=\"center\" cellpadding=\"0\" cellspacing=\"0\" class=\"tr-caption-container\" style=\"margin-left: auto; margin-right: auto; text-align: center;\"><tbody>\n<tr><td style=\"text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgnQhDAup_NdXzYDhGCSS0UZL75r3p6BOZJ0JLOaosNFdxqlQ2O0yUG5LiUZbpbwAesRlxHbDdm1eyNyC4tAc-ZdBzlriJ820O0FvZekl7l5PewIx6D5dEP6mPOWJSMdSJRYG8qz2j3Rik/s1600/1503977_666978866695994_5635282502107450653_n.jpg\" imageanchor=\"1\" style=\"margin-left: auto; margin-right: auto;\"><img border=\"0\" height=\"240\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgnQhDAup_NdXzYDhGCSS0UZL75r3p6BOZJ0JLOaosNFdxqlQ2O0yUG5LiUZbpbwAesRlxHbDdm1eyNyC4tAc-ZdBzlriJ820O0FvZekl7l5PewIx6D5dEP6mPOWJSMdSJRYG8qz2j3Rik/s1600/1503977_666978866695994_5635282502107450653_n.jpg\" width=\"320\" /></a></td></tr>\n<tr><td class=\"tr-caption\" style=\"text-align: center;\">obetisko je akýsi prírodný amfiteáter.</td></tr>\n</tbody></table>\n<br /></div>\n<div style=\"text-align: justify;\">\nNa záver dodám, že cenu každej tabule vo výške 150 Eur, ktorá prakticky zodpovedá výrobným nákladom za jej zhotovenie a z ktorej nášmu združeniu neplynie žiaden zisk, nám na základe prísľubu starostu obce Udiča pána Jozefa Slámku uhradí obec Udiča, za čo im patrí veľká vďaka.<br />\n<br />\nFoto: Stanislav Miko<br />\nMiroslav Brindžák<br />\nStanislava Flimmelová<br />\nRobert Plšičík<br />\nOrgoň&nbsp;</div>\n"},"link":[{"rel":"replies","type":"application/atom+xml","href":"http://www.hradiska.sk/feeds/8445343637682773799/comments/default","title":"Zverejniť komentáre"},{"rel":"replies","type":"text/html","href":"http://www.hradiska.sk/2014/04/informacne-tabule-prosne-zlaty-kon.html#comment-form","title":"5 komentárov"},{"rel":"edit","type":"application/atom+xml","href":"http://www.blogger.com/feeds/6818054921907446479/posts/default/8445343637682773799"},{"rel":"self","type":"application/atom+xml","href":"http://www.blogger.com/feeds/6818054921907446479/posts/default/8445343637682773799"},{"rel":"alternate","type":"text/html","href":"http://www.hradiska.sk/2014/04/informacne-tabule-prosne-zlaty-kon.html","title":"Informačné tabule Prosné - Zlatý kôň a Uhliská"}],"author":[{"name":{"$t":"Orgon"},"uri":{"$t":"http://www.blogger.com/profile/01396912608531297025"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"32","height":"32","src":"//blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjRf79q2mlg3o6hsyWbYMCCgv1WaA6pM0mtkWB0QdJ76W64emXoS0lwpSlUw9K5iinuoAVrX4RwIXY0RoOkY_QRl8Yy2oMkJAodsY_W7_GnMHXspVw3fuuBpiYA7JlSOlY/s220/SH+Kruh+s+dlznom1.JPG"}}],"media$thumbnail":{"xmlns$media":"http://search.yahoo.com/mrss/","url":"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgMBXr1OGCDiAkmt430Cicbrw_lBrb1xLTY0tb8Ia3at1oGceqPnykW0k6yyGDe-6YFBQ29Cd-BX6OspPTlVDf_QbGC9_RZv_Uhu7DBkN053zoQ-ahRXLVaVfqgEEqJZdCnnR7TJWzv1gw/s72-c/tabu%C4%BEa+k%C3%B4%C5%88+mapa.JPG","height":"72","width":"72"},"thr$total":{"$t":"5"}}]}}