" data-original-width=\"2048\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjvirfuttXiMFrgwWn4i-QUMAL4c3syb8RQnU86yzQ1g4-wj9jSWOtLIqopi5x0xgve6rcWijBotww32d4V3dtGl5onYTMvfEWc88HV_wh0tLeBtq5xF-duCtP8fZtXSD0o5b5cdKTER4xP/s320/IMG_8466.JPG\" width=\"320\" /></a></div><br /><div class=\"separator\" style=\"clear: both; text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiwu_J1OcndN8FH5LjGtzEQiAFxTXW6mCUaCfFNNnLJvn33nV79VYZNLPOikP4XqZMDUWWHdH35f_EvfltBs4614859TJPQTi_c2Gc-FGEEyIpnyw4QkYXhD1DOFwq_HhwPR8dicua8KJSI/s2048/IMG_8472.JPG\" style=\"margin-left: 1em; margin-right: 1em;\"><img border=\"0\" data-original-height=\"1365\" data-original-width=\"2048\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiwu_J1OcndN8FH5LjGtzEQiAFxTXW6mCUaCfFNNnLJvn33nV79VYZNLPOikP4XqZMDUWWHdH35f_EvfltBs4614859TJPQTi_c2Gc-FGEEyIpnyw4QkYXhD1DOFwq_HhwPR8dicua8KJSI/s320/IMG_8472.JPG\" width=\"320\" /></a></div><br />&nbsp;<br /></span></span><p style=\"text-align: left;\"></p><p style=\"line-height: 100%; margin-bottom: 0cm; text-align: left;\"><span style=\"font-family: Times New Roman, serif;\"><span style=\"font-size: small;\"><br /></span></span></p>\n\n<p style=\"line-height: 100%; margin-bottom: 0cm; text-align: left;\"><span style=\"font-family: Times New Roman, serif;\"><span style=\"font-size: small;\"><style type=\"text/css\">P { margin-bottom: 0.21cm }</style> </span></span></p>\n\n<p style=\"text-align: left;\"><style type=\"text/css\">P { margin-bottom: 0.21cm }</style></p>"},"link":[{"rel":"replies","type":"application/atom+xml","href":"http://www.hradiska.sk/feeds/3700953177840792415/comments/default","title":"Zverejniť komentáre"},{"rel":"replies","type":"text/html","href":"http://www.hradiska.sk/2021/02/stupava-draci-hradok.html#comment-form","title":"0 komentárov"},{"rel":"edit","type":"application/atom+xml","href":"http://www.blogger.com/feeds/6818054921907446479/posts/default/3700953177840792415"},{"r