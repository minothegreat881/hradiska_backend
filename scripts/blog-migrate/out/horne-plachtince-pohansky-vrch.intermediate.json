      {
        "__component": "content.rich-text",
        "body": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Na hradisko vedie náučný chodník, lemovaný informačnými tabuľami, na ktorých sa síce pomaly objavuje zub času, avšak vďaka Perúnovi aj za to. V každom prípade za náučný chodník patrí Plachtinciam pochvala."
              }
            ]
          }
        ]
      },
