                "bold": true,
                "italic": true
              },
              {
                "type": "text",
                "text": "\n \nnad mestom sa vypína,\nhora krásna visutá,\na v tej hore horičke,\naj Ty kráčaš si po cestičke,",
                "italic": true
              }
            ]
          }
        ]
      },
      {
        "__component": "content.quote-block",
        "text": "zrazu vítajú Ťa hradieb skaliská,tie pozostatky Zámčiska,Matka Zem ich pre nás chráni,prikrývkou pôdy tajomstvo predkov bráni,"
      },
      {
        "__component": "content.rich-text",
        "body": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "tajomstvo národa v sláve slova\nnárod, ktorý už dosť má boja,",
                "italic": true
              },
              {
                "type": "text",
                "text": "\npredkovia naši zhynuli tu pred časom v boji,\ntu kde Láska k predkom, potomkov spoluprácou znovu v sile spojí\nbez zbraní a bez boja\nprácou krásu obnovia",
                "italic": true
              }
            ]
          }
        ]
      }
